# 应用启动配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 豆包模型配置
DOUBAO_API_KEY=YOUR_DOUBAO_API_KEY
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250615
DOUBAO_TEMPERATURE=0.3
DOUBAO_TIMEOUT_SECONDS=15
DOUBAO_MAX_RETRIES=1
# 留空时复用DOUBAO_MODEL。
KNOWLEDGE_QUESTION_MODEL=
KNOWLEDGE_QUESTION_TEMPERATURE=0.6
KNOWLEDGE_QUESTION_TIMEOUT_SECONDS=30

# 语义理解：使用独立的快速模型，hybrid表示失败后关键词兜底
UNDERSTANDING_MODE=hybrid
UNDERSTANDING_API_KEY=YOUR_UNDERSTANDING_API_KEY
UNDERSTANDING_BASE_URL=https://api.deepseek.com
UNDERSTANDING_MODEL=deepseek-v4-flash
UNDERSTANDING_TEMPERATURE=0.0
UNDERSTANDING_TIMEOUT_SECONDS=10
UNDERSTANDING_CONFIDENCE_THRESHOLD=0.65

# Redis 7.2会话配置：装好服务后把memory改成redis
SESSION_STORE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SESSION_TTL_SECONDS=1800
REDIS_SESSION_KEY_PREFIX=cs:session:

# PostgreSQL 18配置：装好数据库后把memory改成postgres
PERSISTENCE_BACKEND=memory
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/smart_customer_service
DATABASE_ECHO=false
# 首次开发联调可设为true自动建表，生产环境应使用数据库迁移工具。
DATABASE_AUTO_CREATE_TABLES=false

# 问题收集：先执行Java Flyway V8/V10，再开启Python每日调度。
LEARNING_ENABLED=false
LEARNING_SCHEDULER_ENABLED=false
LEARNING_SCHEDULE_TIMEZONE=Asia/Shanghai
LEARNING_SCHEDULE_HOUR=3
LEARNING_SCHEDULE_MINUTE=0
LEARNING_MAX_BATCHES=100
LEARNING_BATCH_SIZE=100
LEARNING_EMBEDDING_CONCURRENCY=5
LEARNING_MAX_RETRIES=3
LEARNING_STALE_AFTER_MINUTES=30
LEARNING_CLUSTER_DISTANCE_THRESHOLD=0.38
LEARNING_REVIEW_OCCURRENCE_THRESHOLD=3
LEARNING_REVIEW_USER_THRESHOLD=2
LEARNING_ANSWER_TEMPERATURE=0.2
LEARNING_ANSWER_TIMEOUT_SECONDS=30
LEARNING_PACKAGE_TEMPERATURE=0.5
LEARNING_PACKAGE_TIMEOUT_SECONDS=30
RELEASE_EVALUATION_TOP_K=5
RELEASE_MIN_RECALL_AT_1=0.8
RELEASE_MIN_RECALL_AT_3=1.0
RELEASE_MIN_THRESHOLD_RECALL=0.8
RELEASE_MAX_HARD_NEGATIVE_FALSE_POSITIVE_RATE=0.0
RELEASE_EVALUATION_CONCURRENCY=3

# Java 真实业务 Tool。两个服务必须使用同一个内部令牌，且不要把真实令牌提交到 Git。
BUSINESS_TOOL_BASE_URL=http://127.0.0.1:8081
BUSINESS_TOOL_INTERNAL_TOKEN=YOUR_INTERNAL_TOOL_TOKEN
BUSINESS_TOOL_TIMEOUT_SECONDS=5

# Nacos 3.2.3：管理Python提示词版本，并发现Java MCP Server。
# 真实账号密码只写入本地.env或部署平台，不能提交到Git。
NACOS_ENABLED=false
NACOS_SERVER_ADDR=http://127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_USERNAME=YOUR_NACOS_USERNAME
NACOS_PASSWORD=YOUR_NACOS_PASSWORD
NACOS_PROMPT_LABEL=stable
NACOS_TIMEOUT_SECONDS=5

# Java业务工具的MCP配置；发现失败时会使用MCP_SERVER_URL作为降级地址。
MCP_ENABLED=false
MCP_SERVER_NAME=smart-customer-business-tools
MCP_SERVER_URL=http://127.0.0.1:8081/mcp

# MCP Tool 语义召回：先从 Redis Search 选出 Top K，再把候选 Schema 交给理解模型。
TOOL_RETRIEVAL_ENABLED=false
TOOL_RETRIEVAL_INDEX_NAME=idx:cs:mcp-tools
TOOL_RETRIEVAL_KEY_PREFIX=cs:mcp:tool:
TOOL_RETRIEVAL_TOP_K=3
TOOL_RETRIEVAL_MAX_DISTANCE=0.80
TOOL_RETRIEVAL_TIMEOUT_SECONDS=100.0

# 认证功能完成前使用固定测试用户
DEMO_USER_ID=demo-user-001
# Redis Search知识库与自建LangCache
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIMENSION=2048
EMBEDDING_TIMEOUT_SECONDS=15
KNOWLEDGE_INDEX_NAME=idx:cs:knowledge
KNOWLEDGE_KEY_PREFIX=cs:knowledge:doc:
KNOWLEDGE_DISTANCE_THRESHOLD=0.38
KNOWLEDGE_TOP_K=3
LANGCACHE_INDEX_NAME=idx:cs:langcache
LANGCACHE_KEY_PREFIX=cs:langcache:entry:
LANGCACHE_DISTANCE_THRESHOLD=0.20
LANGCACHE_TTL_SECONDS=3600
LANGCACHE_FREQUENCY_THRESHOLD=5
LANGCACHE_GAP_INDEX_NAME=idx:cs:langcache-gap
LANGCACHE_GAP_KEY_PREFIX=cs:langcache:gap:
LANGCACHE_GAP_WINDOW_SECONDS=86400
SEMANTIC_CACHE_INTENTS=knowledge_query,activity_rules,benefits_query,points_rules,refund_request,order_query

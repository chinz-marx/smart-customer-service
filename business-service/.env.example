# Java 服务与 Python 服务使用同一个 PostgreSQL 实例，但 Java 只管理 business schema。
BUSINESS_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/smart_customer_service
BUSINESS_DATABASE_USERNAME=postgres
BUSINESS_DATABASE_PASSWORD=replace-with-your-password

# refund_apply使用Redis分布式锁；Java和Python可以复用同一个Redis实例。
BUSINESS_REDIS_URL=redis://:replace-with-your-password@127.0.0.1:6379/0

# Python 调用 Java 内部 Tool API 时必须携带相同的 X-Internal-Token 请求头。
TOOL_INTERNAL_TOKEN=replace-with-a-long-random-token

# 默认 8081，部署时可以通过环境变量覆盖。
BUSINESS_SERVER_PORT=8081

# MCP注册到Nacos时对调用方公布的地址。开发环境同机调用可用127.0.0.1；
# 分布式部署必须改成Python服务能够访问的Java内网IP或域名。
NACOS_MCP_SERVER_HOST=127.0.0.1
NACOS_MCP_SERVER_PORT=8081
MCP_SERVER_VERSION=1.3.0


# Java审批通过后调用Python完成切片、Embedding和Redis Search发布。
KNOWLEDGE_SYNC_PYTHON_BASE_URL=http://127.0.0.1:8000
KNOWLEDGE_SYNC_INTERVAL_MS=5000
KNOWLEDGE_SYNC_INITIAL_DELAY_MS=3000
